# Пароль базы (придумайте)
POSTGRES_PASSWORD=
# Адрес и порт веба. В контуре «Инкаб ИИ» (узел ai-ag): WEB_BIND=172.16.50.30, WEB_PORT=8102
WEB_BIND=127.0.0.1
WEB_PORT=8102
SYNC_EVERY=3600
TZ=Asia/Yekaterinburg

# Общий секрет с порталом «Инкаб ИИ». Портал проксирует /orders/ и ставит заголовки
# X-SalesVisor-Token, X-SalesVisor-User (алиас), X-SalesVisor-Person (ФИО). Пусто — без проверки
PORTAL_TOKEN=

# Папка на хосте, куда завод кладёт выгрузки по SFTP, если Metabase с сервера недоступен.
# Нужна, только если METABASE_API_KEY пуст
IMPORT_HOST_DIR=/data/SAP/salesvisor

# Metabase: адрес и API-ключ служебной учётки с доступом только на чтение вопросов 522 и 573
METABASE_URL=https://metabase.incab.ru
METABASE_API_KEY=
METABASE_CARD_SEGMENTS=522
METABASE_CARD_SVETOFOR=573
METABASE_VERIFY_SSL=1

# Битрикс24 (коробка): входящий вебхук вида https://portal/rest/<id>/<key>/
BITRIX_WEBHOOK_URL=
BITRIX_TASK_URL=
BITRIX_POST_COMMENTS=0
BITRIX_DEAL_URL=

# Отчёты ПДО из вложений задач Битрикса через тот же вебхук (только чтение): номера задач через запятую,
# например задача «ВАЖНЫЕ НОВОСТИ У2». Отчёты по материалам старше PDO_MATERIALS_DAYS дней не грузятся.
PDO_TASK_IDS=
PDO_MATERIALS_DAYS=20
